From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Lauri Nomme <lauri.nomme@gmail.com>
Date: Sat, 19 Sep 2026 22:30:41 +0300
Subject: [PATCH] net: ethernet: mtk_eth_soc: reallocate RX rings on runtime MTU change

The RX ring buffers are sized once, at DMA init, from eth->rx_buf_len.
Changing the MTU on a running interface updated rx_buf_len and the PDMA
SDL register but left the already-allocated ring buffers at their old
(smaller) size: a jumbo frame larger than the pre-existing buffer then
overran in skb_put() (skb_over_panic) inside mtk_poll_rx.

The previous fix bounced the whole frame engine by scheduling the heavy
mtk_pending_work reset worker, which tears down every netdev, resets the
FE/WED and reopens them. That is heavyweight for a mere buffer resize and
leaves a grow window in which a MAC was widened (mtk_set_mcr_max_rx)
before the rings could accept the larger frames.

Rework this around a dedicated, light-weight rx_buf_len_work worker that
runs under the MTK_RESETTING flag:

- mtk_rx_buf_len() derives the ring buffer length from the largest netdev
  MTU (1536, or rounded up to the 1024-byte GMAC jumbo length granularity)
  and mtk_dma_init() stores it at ring allocation time, making
  eth->rx_buf_len the single source of truth for the buffers the rings
  actually hold.
- The DMA ring bring-up/teardown is factored into mtk_rings_start() /
  mtk_rings_stop(), called by mtk_open()/mtk_stop(), and re-invoked by the
  worker without touching phylink or the netdevs, so the links never flap.
- mtk_rx_buf_len_work() stops the rings, reallocates them at the new size
  and restarts them, ordering the MAC max-rx writes so that shrinking
  narrows the MACs first and growing widens them only once the rings fit
  the larger frames.
- The PDMA SDL (max RX frame) is programmed in mtk_dma_init() from the
  just-derived rx_buf_len on every ring allocation, covering the MT7988
  non-HWLRO path.
- mtk_change_mtu() only updates the MTU and the PPE, then schedules the
  worker when a live reallocation is required.

Signed-off-by: Lauri Nomme <lauri.nomme@gmail.com>
---
--- a/drivers/net/ethernet/mediatek/mtk_eth_soc.c
+++ b/drivers/net/ethernet/mediatek/mtk_eth_soc.c
@@ -597,6 +597,9 @@ static int mtk_mac_prepare(struct phylin
 
 static void mtk_set_mcr_max_rx(struct mtk_mac *mac, u32 val);
 
+static int mtk_max_gmac_mtu(struct mtk_eth *eth);
+static u32 mtk_rx_buf_len(struct mtk_eth *eth);
+
 static void mtk_mac_config(struct phylink_config *config, unsigned int mode,
 			   const struct phylink_link_state *state)
 {
@@ -3614,6 +3617,12 @@ static int mtk_dma_init(struct mtk_eth *
 	if (mtk_dma_busy_wait(eth))
 		return -EBUSY;
 
+	/* Derived here, at ring allocation, so eth->rx_buf_len always describes
+	 * the buffers the rings actually hold and mtk_mac_config() never lets
+	 * a MAC accept a frame the rings cannot take.
+	 */
+	eth->rx_buf_len = mtk_rx_buf_len(eth);
+
 	if (MTK_HAS_CAPS(eth->soc->caps, MTK_QDMA)) {
 		/* QDMA needs scratch memory for internal reordering of the
 		 * descriptors
@@ -3668,6 +3677,20 @@ static int mtk_dma_init(struct mtk_eth *
 		mtk_w32(eth, 0x0, eth->soc->reg_map->qdma.hred);
 	}
 
+	/* Program the PDMA max RX frame (SDL) from the just-derived
+	 * rx_buf_len so jumbo frames up to it are accepted by the DMA
+	 * engine.  This is the non-HWLRO path (MT7988); the HWLRO rings
+	 * re-sync SDL from mtk_hwlro_rx_init() instead.  Runs on every ring
+	 * (re)allocation, keeping SDL in lockstep with the buffers.
+	 */
+	if (mtk_is_netsys_v3_or_greater(eth)) {
+		u32 val = mtk_r32(eth, eth->soc->reg_map->pdma.rx_cfg);
+
+		mtk_w32(eth, val | ((MTK_PDMA_LRO_SDL + eth->rx_buf_len) <<
+			MTK_RX_CFG_SDL_OFFSET),
+			eth->soc->reg_map->pdma.rx_cfg);
+	}
+
 	return 0;
 }
 
@@ -4048,14 +4071,81 @@ static int mtk_max_gmac_mtu(struct mtk_e
 	return max_mtu;
 }
 
+/* The rx rings are shared by every MAC, so their buffers are sized for the
+ * largest MTU configured on any of them: MTK_MAX_RX_LENGTH when that fits,
+ * otherwise the next multiple of 1024, the granularity of the GMAC jumbo
+ * length field (yields 2048/9216 for our 2K/9K MTUs).
+ */
+static u32 mtk_rx_buf_len(struct mtk_eth *eth)
+{
+	int length = mtk_max_gmac_mtu(eth) + MTK_RX_ETH_HLEN;
+
+	if (length <= MTK_MAX_RX_LENGTH)
+		return MTK_MAX_RX_LENGTH;
+
+	return DIV_ROUND_UP(length, 1024) * 1024;
+}
+
+static int mtk_rings_start(struct mtk_eth *eth)
+{
+	const struct mtk_soc_data *soc = eth->soc;
+	u32 gdm_config;
+	int i, err, mtu;
+
+	err = mtk_start_dma(eth);
+	if (err)
+		return err;
+
+	for (i = 0; i < ARRAY_SIZE(eth->ppe); i++)
+		mtk_ppe_start(eth->ppe[i]);
+
+	for (i = 0; i < MTK_MAX_DEVS; i++) {
+		struct mtk_mac *target_mac;
+
+		if (!eth->netdev[i])
+			continue;
+
+		target_mac = netdev_priv(eth->netdev[i]);
+		if (!soc->offload_version) {
+			target_mac->ppe_idx = 0;
+			gdm_config = MTK_GDMA_TO_PDMA;
+		} else if (soc->ppe_num >= 3 && target_mac->id == 2) {
+			target_mac->ppe_idx = 2;
+			gdm_config = soc->reg_map->gdma_to_ppe[2];
+		} else if (soc->ppe_num >= 2 && target_mac->id == 1) {
+			target_mac->ppe_idx = 1;
+			gdm_config = soc->reg_map->gdma_to_ppe[1];
+		} else {
+			target_mac->ppe_idx = 0;
+			gdm_config = soc->reg_map->gdma_to_ppe[0];
+		}
+		mtk_gdm_config(eth, target_mac->id, gdm_config);
+	}
+
+	mtu = mtk_max_gmac_mtu(eth);
+	for (i = 0; i < ARRAY_SIZE(eth->ppe); i++)
+		mtk_ppe_update_mtu(eth->ppe[i], mtu);
+
+	napi_enable(&eth->tx_napi);
+	napi_enable(&eth->rx_napi[0].napi);
+	mtk_tx_irq_enable(eth, MTK_TX_DONE_INT);
+	mtk_rx_irq_enable(eth, MTK_RX_DONE_INT(0));
+
+	if (MTK_HAS_CAPS(eth->soc->caps, MTK_RSS)) {
+		for (i = 1; i < MTK_RX_RSS_NUM; i++) {
+			napi_enable(&eth->rx_napi[MTK_RSS_RING(i)].napi);
+			mtk_rx_irq_enable(eth, MTK_RX_DONE_INT(MTK_RSS_RING(i)));
+		}
+	}
+
+	return 0;
+}
+
